OBSISSTANT_URL=https://ob
# Workspace Relay Key (recommended: auto-syncs ALL active Studios created in /admin/obs-studios)
OBSISSTANT_RELAY_TOKEN=paste_workspace_relay_token_here

# Or pair a single standalone Studio instead:
# OBSISSTANT_AGENT_TOKEN=

# Optional local overrides (leave blank to use host/port/password saved in Obsisstant UI)
OBS_WS_URL=
OBS_WS_PASSWORD=
